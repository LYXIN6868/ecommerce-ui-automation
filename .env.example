# 目标站点
BASEURL=https://www.saucedemo.com/

# saucedemo 演示账号
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_USER=locked_out_user

# 显式等待时间（秒）
SELENIUM_TIMEOUT=10

# 1 = 无头模式，0 = 显示浏览器
HEADLESS=0

# 可选：手动指定 chromedriver 路径
# 例如本机 PATH 里有旧版驱动时，指定与 Chrome 匹配的版本
# CHROMEDRIVER=D:\tools\chromedriver.exe

# 截图目录
SCREENSHOT_DIR=screenshot
